## The harbor breakwater, striped Faro, Gozzo fleet, and wheeling gulls

Two rings of hillside dwellings and a fourteen-step cobblestone stairway (`Scalinata Antica`) cascade down to the harbor cove (`harborGroup`). A two-segment stone breakwater mole shelters the timber jetties and ends at the red-and-cream striped Faro lighthouse, whose lantern room projects a dual volumetric light cone (`beamPivot`).

Six wooden Gozzo boats populate the water: three bob at their moorings inside the cove, and three cruise an elliptical path around the island with white wakes trailing behind them. Thirty-four cypress and olive trees dot the middle slopes, eight tall cypresses line the windmill ridge, and ten seagulls circle high above the Duomo.

=>

  Array.forEach(Array.makeBy(24, (i) => i), (i) => {
    const angle = (i / 24) * Math.PI * 2
    const radius = 6.6 + (i % 3) * 1.45 + (rng() - 0.5) * 0.8
    const hx = 1.4 + Math.cos(angle) * radius
    const hz = -0.6 + Math.sin(angle) * radius
    if (!(hx > 4.5 && hz > 4.5)) {
      buildHouse({
        x: hx,
        y: 5.45 - (radius > 8.2 ? 0.1 : 0),
        z: hz,
        w: 1.25 + rng() * 0.65,
        h: 1.55 + rng() * 1.25,
        d: 1.25 + rng() * 0.6,
        rotY: -angle + Math.PI / 2 + (rng() - 0.5) * 0.35,
        districtId: 'terraces',
      })
    }
  })

  Array.forEach(Array.makeBy(16, (i) => i), (i) => {
    const angle = (i / 16) * Math.PI * 2 + 0.2
    const radius = 11.4 + (rng() - 0.5) * 1.1
    const hx = 0.5 + Math.cos(angle) * radius
    const hz = 0.2 + Math.sin(angle) * radius
    if (!(hx > 3.5 && hz > 3.5)) {
      buildHouse({
        x: hx,
        y: 2.05,
        z: hz,
        w: 1.3 + rng() * 0.55,
        h: 1.6 + rng() * 0.95,
        d: 1.25 + rng() * 0.5,
        rotY: -angle + Math.PI / 2,
        districtId: 'terraces',
      })
    }
  })

  Array.forEach(Array.makeBy(14, (s) => s), (s) => {
    const t = s / 13
    const stepMesh = new THREE.Mesh(
      new THREE.BoxGeometry(1.15, 0.24, 0.65),
      cobbleMat,
    )
    stepMesh.position.set(
      THREE.MathUtils.lerp(6.8, 2.4, t),
      THREE.MathUtils.lerp(2.1, 7.6, t),
      THREE.MathUtils.lerp(6.8, 3.2, t),
    )
    stepMesh.rotation.y = 0.65
    stepMesh.receiveShadow = true
    townRoot.add(stepMesh)
  })

  const harborGroup = new THREE.Group()
  harborGroup.position.set(6.5, 0, 7.0)

  const pier1 = new THREE.Mesh(
    new THREE.BoxGeometry(7.2, 1.5, 1.8),
    stoneWallMat,
  )
  pier1.position.set(0.8, 0.65, 1.2)
  pier1.rotation.y = -0.35
  pier1.castShadow = true
  pier1.receiveShadow = true
  harborGroup.add(pier1)

  const pier2 = new THREE.Mesh(
    new THREE.BoxGeometry(4.8, 1.5, 1.6),
    stoneWallMat,
  )
  pier2.position.set(4.6, 0.65, 3.6)
  pier2.rotation.y = -1.05
  pier2.castShadow = true
  pier2.receiveShadow = true
  harborGroup.add(pier2)

  const dockMat = new THREE.MeshStandardMaterial({
    color: 0x735135,
    roughness: 0.85,
  })
  Array.forEach([0, 1], (d) => {
    const jetty = new THREE.Mesh(
      new THREE.BoxGeometry(0.75, 0.16, 2.6),
      dockMat,
    )
    jetty.position.set(-0.6 + d * 1.9, 0.65, 2.9 + d * 0.5)
    jetty.rotation.y = -0.35
    jetty.castShadow = true
    harborGroup.add(jetty)
  })

  const faroX = 5.6
  const faroZ = 5.4
  const faroBase = new THREE.Mesh(
    new THREE.CylinderGeometry(0.82, 0.96, 1.4, 10),
    stoneWallMat,
  )
  faroBase.position.set(faroX, 1.35, faroZ)
  faroBase.castShadow = true
  harborGroup.add(faroBase)

  const stripeWhite = new THREE.MeshStandardMaterial({
    color: 0xfaf6ed,
    roughness: 0.65,
  })
  const stripeRed = new THREE.MeshStandardMaterial({
    color: 0xc93b2b,
    roughness: 0.65,
  })

  Array.forEach([0, 1, 2, 3], (s) => {
    const seg = new THREE.Mesh(
      new THREE.CylinderGeometry(
        0.56 - s * 0.04,
        0.6 - s * 0.04,
        0.72,
        10,
      ),
      s % 2 === 0 ? stripeWhite : stripeRed,
    )
    seg.position.set(faroX, 2.35 + s * 0.72, faroZ)
    seg.castShadow = true
    harborGroup.add(seg)
  })

  const faroLantern = new THREE.Mesh(
    new THREE.CylinderGeometry(0.42, 0.42, 0.65, 10),
    makeLanternMaterial(),
  )
  faroLantern.position.set(faroX, 5.2, faroZ)
  harborGroup.add(faroLantern)

  const faroCap = new THREE.Mesh(
    new THREE.ConeGeometry(0.55, 0.55, 10),
    stripeRed,
  )
  faroCap.position.set(faroX, 5.75, faroZ)
  harborGroup.add(faroCap)

  const beamPivot = new THREE.Group()
  beamPivot.position.set(faroX, 5.2, faroZ)

  const beamGeo = new THREE.ConeGeometry(2.6, 14, 16, 1, true)
  beamGeo.translate(0, -7, 0)
  beamGeo.rotateX(-Math.PI / 2)
  const beamMat = new THREE.MeshBasicMaterial({
    color: 0xffe49e,
    transparent: true,
    opacity: lanternsLit ? 0.16 : 0.0,
    side: THREE.DoubleSide,
    depthWrite: false,
  })
  const beamCone = new THREE.Mesh(beamGeo, beamMat)
  beamPivot.add(beamCone)

  const beamConeBack = new THREE.Mesh(beamGeo, beamMat)
  beamConeBack.rotation.y = Math.PI
  beamPivot.add(beamConeBack)

  harborGroup.add(beamPivot)
  tagDistrict(districtClickTargets, harborGroup, 'harbor')
  townRoot.add(harborGroup)

  Array.forEach(Array.makeBy(7, (i) => i), (i) => {
    const t = i / 6
    buildHouse({
      x: THREE.MathUtils.lerp(3.5, 9.2, t),
      y: 1.35,
      z: THREE.MathUtils.lerp(8.5, 5.8, t),
      w: 1.2 + rng() * 0.4,
      h: 1.55 + rng() * 0.75,
      d: 1.2 + rng() * 0.35,
      rotY: -0.42,
      districtId: 'harbor',
    })
  })

  const hullColors: ReadonlyArray<number> = [
    0x1e5c8a, 0xc93b2b, 0x287a5c, 0xd98a26, 0x2d4c73, 0xa8383b,
  ]

  const createBoatMesh = (hullColor: number, withSail: boolean): THREE.Group => {
    const boat = new THREE.Group()

    const hull = new THREE.Mesh(
      new THREE.BoxGeometry(0.72, 0.28, 1.55),
      new THREE.MeshStandardMaterial({ color: hullColor, roughness: 0.6 }),
    )
    hull.position.y = 0.12
    hull.castShadow = true
    boat.add(hull)

    const deckTrim = new THREE.Mesh(
      new THREE.BoxGeometry(0.78, 0.08, 1.62),
      new THREE.MeshStandardMaterial({ color: 0xf7f2e6, roughness: 0.7 }),
    )
    deckTrim.position.y = 0.26
    boat.add(deckTrim)

    const cabin = new THREE.Mesh(
      new THREE.BoxGeometry(0.44, 0.28, 0.52),
      new THREE.MeshStandardMaterial({ color: 0xede4d3, roughness: 0.7 }),
    )
    cabin.position.set(0, 0.4, -0.15)
    boat.add(cabin)

    const bowLantern = new THREE.Mesh(
      new THREE.SphereGeometry(0.08, 6, 6),
      makeLanternMaterial(),
    )
    bowLantern.position.set(0, 0.42, 0.68)
    boat.add(bowLantern)

    if (withSail) {
      const mast = new THREE.Mesh(
        new THREE.CylinderGeometry(0.03, 0.04, 1.45, 6),
        dockMat,
      )
      mast.position.set(0, 0.9, 0.15)
      boat.add(mast)

      const sail = new THREE.Mesh(
        new THREE.ConeGeometry(0.55, 1.25, 3),
        new THREE.MeshStandardMaterial({
          color: 0xfff8eb,
          roughness: 0.65,
          side: THREE.DoubleSide,
        }),
      )
      sail.position.set(0.08, 0.98, 0.15)
      sail.scale.set(0.25, 1, 1.1)
      sail.castShadow = true
      boat.add(sail)
    }

    return boat
  }

  const mooredCoords: ReadonlyArray<readonly [number, number, number]> = [
    [5.5, 10.6, 0.3],
    [7.4, 11.2, -0.2],
    [9.3, 11.8, 0.5],
  ]
  Array.forEach(mooredCoords, ([bx, bz, rot], idx) => {
    const hullColor = Option.getOrElse(
      Option.fromNullishOr(hullColors[idx]),
      () => 0x1e5c8a,
    )
    const boatGroup = createBoatMesh(hullColor, idx === 1)
    boatGroup.position.set(bx, 0.05, bz)
    boatGroup.rotation.y = rot
    tagDistrict(districtClickTargets, boatGroup, 'harbor')
    townRoot.add(boatGroup)
    boats.push({
      group: boatGroup,
      mode: 'moored',
      basePos: new THREE.Vector3(bx, 0.05, bz),
      orbitRadiusX: 0,
      orbitRadiusZ: 0,
      orbitCenter: new THREE.Vector3(),
      phase: idx * 1.7,
      speed: 1.2,
      wakeMesh: Option.none(),
    })
  })

  Array.forEach([0, 1, 2], (s) => {
    const hullColor = Option.getOrElse(
      Option.fromNullishOr(hullColors[s + 3]),
      () => 0xd98a26,
    )
    const boatGroup = createBoatMesh(hullColor, true)
    const wakeMat = new THREE.MeshBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.38,
      side: THREE.DoubleSide,
    })
    const wakeGeo = new THREE.PlaneGeometry(0.65, 2.1)
    wakeGeo.rotateX(-Math.PI / 2)
    const wakeMesh = new THREE.Mesh(wakeGeo, wakeMat)
    wakeMesh.position.set(0, 0.03, -1.25)
    boatGroup.add(wakeMesh)

    tagDistrict(districtClickTargets, boatGroup, 'harbor')
    townRoot.add(boatGroup)

    boats.push({
      group: boatGroup,
      mode: 'sailing',
      basePos: new THREE.Vector3(),
      orbitRadiusX: 20.5 + s * 3.4,
      orbitRadiusZ: 18.5 + s * 3.0,
      orbitCenter: new THREE.Vector3(0.5, 0.06, 1.0),
      phase: (s * Math.PI * 2) / 3,
      speed: 0.14 + s * 0.035,
      wakeMesh: Option.some(wakeMesh),
    })
  })

  Array.forEach(Array.makeBy(34, (i) => i), () => {
    const angle = rng() * Math.PI * 2
    const dist = 5.0 + rng() * 9.5
    const tx = Math.cos(angle) * dist
    const tz = Math.sin(angle) * dist
    if (!(tx > 4 && tz > 4)) {
      const ty = dist < 7.5 ? 7.6 : dist < 11.2 ? 5.4 : 2.1
      const scale = 0.72 + rng() * 0.52
      if (rng() > 0.38) {
        buildCypressTree(townRoot, swayingTrees, tx, ty, tz, scale, rng)
      } else {
        buildOliveTree(townRoot, swayingTrees, tx, ty, tz, scale, rng)
      }
    }
  })

  Array.forEach(Array.makeBy(8, (i) => i), (i) => {
    buildCypressTree(
      townRoot,
      swayingTrees,
      -7.2 - i * 0.7,
      7.75,
      0.4 + (i % 2) * 3.2,
      0.85 + rng() * 0.35,
      rng,
    )
  })

  const gullMat = new THREE.MeshStandardMaterial({
    color: 0xffffff,
    roughness: 0.5,
  })
  const wingTipMat = new THREE.MeshStandardMaterial({
    color: 0x2b3440,
    roughness: 0.6,
  })

  Array.forEach(Array.makeBy(10, (g) => g), (g) => {
    const gullGroup = new THREE.Group()
    const body = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.36, 5), gullMat)
    body.rotation.x = Math.PI / 2
    gullGroup.add(body)

    const leftWing = new THREE.Group()
    const lwMesh = new THREE.Mesh(
      new THREE.BoxGeometry(0.42, 0.025, 0.14),
      g % 2 === 0 ? gullMat : wingTipMat,
    )
    lwMesh.position.x = -0.21
    leftWing.add(lwMesh)
    gullGroup.add(leftWing)

    const rightWing = new THREE.Group()
    const rwMesh = new THREE.Mesh(
      new THREE.BoxGeometry(0.42, 0.025, 0.14),
      g % 2 === 0 ? gullMat : wingTipMat,
    )
    rwMesh.position.x = 0.21
    rightWing.add(rwMesh)
    gullGroup.add(rightWing)

    townRoot.add(gullGroup)
    seagulls.push({
      group: gullGroup,
      leftWing,
      rightWing,
      center: new THREE.Vector3(
        (rng() - 0.5) * 8,
        14.5 + rng() * 5.5,
        (rng() - 0.5) * 8,
      ),
      radius: 5.5 + rng() * 7.5,
      phase: (g / 10) * Math.PI * 2,
      speed: 0.55 + rng() * 0.35,
      heightOffset: rng() * Math.PI * 2,
    })
  })

  return {
    districtClickTargets,
    windowEmissiveMaterials,
    lanternBulbMaterials,
    windmillRotorGroup: Option.some(rotor),
    lighthouseBeamGroup: Option.some(beamPivot),
    lighthouseBeamMat: Option.some(beamMat),
    campanileBellGroup: Option.some(bellPivot),
    swayingTrees,
    boats,
    seagulls,
    smokePuffs,
    fountainDrops,
    chimeRings,
  }
}

## What the architecture module draws on

The module draws `Array` and `Option` from `effect`, geometry and material primitives from `three`, the `DistrictId` and `TownPalette` types from `../shared/domain`, and the `PaletteColors`, `makeRng`, and `paletteColorsOf` helpers from `./palettes`.

=>

import { Array, Option } from 'effect'
import * as THREE from 'three'

import type { DistrictId, TownPalette } from '../shared/domain'
import { type PaletteColors, makeRng, paletteColorsOf } from './palettes'

